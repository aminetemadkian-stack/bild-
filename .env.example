APP_NAME=ArchAI Multi-Agent Starter
DATABASE_PATH=./data/archai.db
HOST=127.0.0.1
PORT=8000
# Keep secrets in environment variables. Never commit API keys.
# demo or openai_compatible
LLM_PROVIDER=demo
# For OpenAI, the API root is usually https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90
# Chat history is off by default; expired messages are deleted automatically.
CHAT_HISTORY_ENABLED=false
CHAT_HISTORY_RETENTION_DAYS=30
